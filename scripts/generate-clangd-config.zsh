#!/bin/zsh

set -euo pipefail
setopt null_glob

code_root=${1:-/Users/pingy/code}
config_file=${2:-/Users/pingy/Library/Preferences/clangd/config.yaml}

if [[ ! -d "$code_root" ]]; then
  print -u2 -- "code root does not exist: $code_root"
  exit 1
fi

config_dir=${config_file:h}
mkdir -p "$config_dir"
tmp_file=$(mktemp "$config_dir/config.yaml.XXXXXX")
trap 'rm -f "$tmp_file"' EXIT

# These are build products, downloaded applications, virtual environments, or
# editor worktrees. Their bundled headers should not leak into normal projects.
find_repositories() {
  find "$code_root" \
    \( -name .claude -o -name .codex-worktrees -o -name node_modules \
       -o -name build -o -name dist -o -name .venv -o -name venv \) -prune \
    -o -name .git -print -prune 2>/dev/null \
    | sed 's#/.git$##' \
    | sort -u
}

has_cpp_sources() {
  local repo=$1
  find "$repo" \
    \( -name .git -o -name .claude -o -name node_modules -o -name build \
       -o -name dist -o -name .venv -o -name venv \) -prune \
    -o -type f \
    \( -name '*.c' -o -name '*.cc' -o -name '*.cpp' -o -name '*.cxx' \
       -o -name '*.h' -o -name '*.hh' -o -name '*.hpp' -o -name '*.hxx' \) \
    -print -quit 2>/dev/null | grep -q .
}

include_directories() {
  local repo=$1

  # The repository root and src/ cover projects that keep private headers next
  # to sources. Every include/ or inc/ directory covers the usual CMake layout.
  print -r -- "$repo"
  [[ -d "$repo/src" ]] && print -r -- "$repo/src"

  find "$repo" \
    \( -name .git -o -name .claude -o -name node_modules -o -name build \
       -o -name dist -o -name .venv -o -name venv \) -prune \
    -o -type d \( -name include -o -name inc \) -print 2>/dev/null
}

regex_escape() {
  # Escape the characters that can occur in a path and are meaningful in an
  # LLVM regular expression. Paths are emitted as quoted YAML scalars below.
  print -r -- "$1" | sed 's/[][(){}.^$+*?|\\]/\\&/g'
}

{
  print '# Generated by ~/.config/nvim/scripts/generate-clangd-config.zsh.'
  print '# Local-only fallback include paths for C/C++ repositories under ~/code.'
  print '# Real compile_commands.json entries still provide the primary flags.'

  configured=0
  skipped_existing=0

  while IFS= read -r repo; do
    [[ -n "$repo" ]] || continue
    has_cpp_sources "$repo" || continue

    # A checked-in/local project configuration is more precise than this
    # heuristic and has higher precedence. Do not duplicate it here.
    if [[ -f "$repo/.clangd" ]]; then
      (( skipped_existing += 1 ))
      continue
    fi

    escaped_repo=$(regex_escape "$repo")
    print -- '---'
    print -- 'If:'
    print -r -- "  PathMatch: \"${escaped_repo}/.*\""
    print -- 'CompileFlags:'
    print -- '  Add:'

    while IFS= read -r include_dir; do
      [[ -n "$include_dir" ]] || continue
      print -r -- "    - \"-I${include_dir}\""
    done < <(include_directories "$repo" | sort -u)

    (( configured += 1 ))
  done < <(find_repositories)

  print -- '# End of generated fragments.'
  print -r -- "# Configured repositories: ${configured}; existing .clangd files preserved: ${skipped_existing}."
} > "$tmp_file"

chmod 0644 "$tmp_file"
mv -f "$tmp_file" "$config_file"
trap - EXIT

print -r -- "wrote $config_file"
tail -n 1 "$config_file"
